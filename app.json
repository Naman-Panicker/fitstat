{
  "expo": {
    "name": "fitstat",
    "slug": "fitstat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitstat_icon.png",
    "splash": {
      "image": "./assets/images/fitstat_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000",
      "dark": {
        "image": "./assets/images/fitstat_icon.png",
        "backgroundColor": "#000000"
      }
    },
    "scheme": "fitstat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/fitstat_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fitstat_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fitstat_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f58947fd-0519-46eb-a207-8ca98ed4f656"
      }
    },
    "owner": "infinitus_02"
  }
}
